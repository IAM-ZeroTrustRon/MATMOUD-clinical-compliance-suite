# Copy this file to .env and populate all values before starting the API.
# NEVER commit .env to source control.

# ── Auth0 ──────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.your-domain.com
AUTH0_NAMESPACE=https://app.your-domain.com

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app_role:password@localhost:5432/clinical_compliance

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
