# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.your-domain.com
AUTH0_NAMESPACE=https://app.your-domain.com

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/clinical_compliance

# AWS S3 (SSE-KMS for HIPAA encryption-at-rest)
AWS_REGION=us-east-1
S3_BUCKET=clinical-compliance-documents
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/your-kms-key-id

# SendGrid (Email Alerts — no PHI in email bodies)
SENDGRID_API_KEY=SG.your-api-key
SENDGRID_TEMPLATE_ID=d-xxxxxxxxxxxx
ALERT_FROM_EMAIL=alerts@clinical-compliance.com
ALERT_RECIPIENT_EMAIL=compliance@clinic.com

# Server
PORT=3000

