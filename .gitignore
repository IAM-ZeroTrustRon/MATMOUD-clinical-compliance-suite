# Application
node_modules/
dist/
build/
.next/
out/

# Environment — NEVER commit secrets or credentials
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp

# Test coverage
coverage/

# TypeScript
*.tsbuildinfo

# Sensitive business / compliance documents — keep off source control
*.pdf
*.docx
*.doc
*.xlsx

# Nested repository — a separate project with its own .git history living inside
# this working tree (audit finding MOUD-18). Ignoring it prevents `git add -A`
# from recording a broken submodule pointer that references a commit no remote has.
grc-case-study-clinical-compliance/
