{
  "name": "clinical-compliance-suite",
  "private": true,
  "version": "1.0.0-beta",
  "description": "MAT/MOUD Clinical Compliance Suite — Monorepo",
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "migrate": "npm run migrate --workspace=apps/api",
    "install:all": "npm install"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "overrides": {
    "qs": "6.16.2"
  },
  "dependencies": {
    "node-cron": "^4.6.0"
  }
}
